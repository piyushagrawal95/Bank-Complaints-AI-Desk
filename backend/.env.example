# ========================================================
# Bank Complaint AI Desk - Backend Environment Template
# ========================================================

# Database (PostgreSQL / Supabase with pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/complaints

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
SUPER_ADMIN_EMAIL=admin@example.com

# Server & CORS Origins
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# LLM & AI Engine (Providers: 'groq' or 'openai')
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Google OAuth2 Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Standard SMTP Email Dispatch (e.g. Gmail / Mailgun / SendGrid SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=your_email@example.com

# Alternative Cloud Email Services (Brevo / Resend / Maileroo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Bank Complaint Desk <onboarding@resend.dev>
MAILEROO_API_KEY=
MAILEROO_FROM=
